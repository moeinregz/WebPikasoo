# ================= متغیرهای محیطی ممد قهوه =================
# روی لیارا: پنل برنامه ← تنظیمات ← متغیرها (بعد از تغییر، برنامه رو ری‌استارت کن)

# آدرس عمومی سایت با https (برای آدرس بازگشت درگاه‌ها و کوکی امن). حتماً دامنه‌ی واقعی.
SITE_URL=https://your-domain.ir

# اولین ورود به پنل مدیریت (فقط موقع ساخته شدن دیتابیس استفاده می‌شه؛ بعدش رمز رو از پنل عوض کن)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# (اختیاری) محل دیتابیس و عکس‌ها. پیش‌فرض: پوشه‌ی data کنار برنامه (روی لیارا همون دیسک)
# DATA_DIR=./data
# DATABASE_PATH=./data/shop.db
# UPLOAD_DIR=./data/uploads

# کلیدهای درگاه‌ها و باسلام از «پنل مدیریت ← تنظیمات» وارد می‌شن، نه این‌جا.
