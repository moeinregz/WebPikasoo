# ===== نمونه متغیرهای محیطی — این فایل را کپی کنید به `.env` (لوکال) =====
# در Production (لیارا) همین‌ها را در بخش «متغیرهای محیطی» پنل تنظیم کنید، نه در فایل.

# آدرس اتصال PostgreSQL (الزامی). فرمت: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://root:PASSWORD@HOST:5432/postgres
# اگر دیتابیس SSL می‌خواهد (معمولاً برای آدرس بیرونی)، true کنید
# PG_SSL=false

# فقط برای اجرای تست‌ها: یک دیتابیس جدا که نامش شامل «test» باشد (همه جدول‌ها پاک می‌شوند!)
# TEST_DATABASE_URL=postgresql://root:PASSWORD@HOST:5432/karimoglu_test

# حساب ادمین اولیه (در Production الزامی است، وگرنه هیچ ادمینی ساخته نمی‌شود)
KARIMOGLU_BOOTSTRAP_ADMIN_MOBILE=09xxxxxxxxx
KARIMOGLU_BOOTSTRAP_ADMIN_PASSWORD=

# کلید «نقشه وب» نشان (برای انتخاب موقعیت روی نقشه). اختیاری: اگر نباشد، دکمه نقشه نمایش داده نمی‌شود.
# بعد از تغییر این متغیر باید دوباره Build/دیپلوی شود (در کد مرورگر قرار می‌گیرد).
# NEXT_PUBLIC_NESHAN_MAP_KEY=web.xxxxxxxx
